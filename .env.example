APP_NAME=Earthquake Hotspot Finder API
APP_ENV=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Replace CHANGE_ME locally. Do not commit a real password.
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/earthquake_hotspot_finder

# Comma-separated frontend origins allowed by FastAPI CORS.
ALLOWED_ORIGINS=http://localhost:5173
